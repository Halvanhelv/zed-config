{
  "autosave": "on_focus_change",
  "icon_theme": "JetBrains Icons Dark",
  "base_keymap": "JetBrains",
  "theme": "Darcula RubyMine",
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 14,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 12,
  "mouse_wheel_zoom": true,
  "soft_wrap": "none",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.bundle",
    "**/.idea",
    "**/.vscode",
    "**/.cursor"
  ],
  "project_panel": {
    "sort_order": "unicode",
    "folder_indicator": "both",
    "dock": "left",
    "git_status": true
  },
  "outline_panel": {
    "folder_indicator": "both",
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "sidebar_side": "right",
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev"
      ]
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.6-luna"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "auto_install_extensions": {
    "ruby": true,
    "vue": true,
    "html": true,
    "emmet": true,
    "toml": true,
    "env": true
  },
  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": false
        }
      }
    },
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "erb": "html",
          "ruby": "html"
        },
        "experimental": {
          "classRegex": [
            "\\bclass:\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    }
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop"
      ],
      "formatter": {
        "language_server": {
          "name": "rubocop"
        }
      }
    },
    "HTML+ERB": {
      "language_servers": [
        "ruby-lsp",
        "herb",
        "tailwindcss-language-server"
      ]
    }
  },
  "agent_servers": {
    "Claude Agent": {
      "type": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp@0.78.0"
      ],
      "env": {}
    }
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "buffer_line_height": {
    "custom": 1.2
  },
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "vertical_scroll_margin": 0,
  "terminal": {
    "option_as_meta": true
  },
  "max_tabs": 10,
  "preview_tabs": {
    "enabled": false
  }
}
