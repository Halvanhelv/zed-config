{
  "autosave": "on_focus_change",
  "icon_theme": "JetBrains Icons Dark",
  "base_keymap": "JetBrains",
  "theme": "Darcula RubyMine",
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 14,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,
  "mouse_wheel_zoom": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "sidebar_side": "right",
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev"
      ]
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.6-luna"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "auto_install_extensions": {
    "ruby": true,
    "vue": true,
    "html": true,
    "emmet": true
  },
  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": false
        }
      }
    },
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "erb": "html",
          "ruby": "html"
        },
        "experimental": {
          "classRegex": [
            "\\bclass:\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    }
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop"
      ],
      "formatter": {
        "language_server": {
          "name": "rubocop"
        }
      }
    },
    "HTML+ERB": {
      "language_servers": [
        "ruby-lsp",
        "herb",
        "tailwindcss-language-server"
      ]
    }
  },
  "agent_servers": {
    "Claude Agent": {
      "type": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp@0.78.0"
      ],
      "env": {}
    }
  },
  "tabs": {
    "close_position": "left"
  },
  "buffer_line_height": {
    "custom": 1.2
  }
}
