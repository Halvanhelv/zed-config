{
  "autosave": "on_focus_change",
  "icon_theme": "JetBrains Icons + Ruby Dark",
  "theme_overrides": {
    "Darcula RubyMine": {
      "text.muted": "#dfe1e5",
      "syntax": {
        "variable.local": { "color": "#d4b021", "font_style": "italic" },
        "variable.parameter": { "color": "#d4b021", "font_style": "italic" },
        "string.special.symbol": { "color": "#89a6ae" },
        "number": { "color": "#74a4c8" },
        "function.builtin": { "color": "#fc9806" },
        "function.method.builtin": { "color": "#fc9806" }
      }
    }
  },
  "base_keymap": "JetBrains",
  "theme": "Darcula RubyMine",
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 12,
  "mouse_wheel_zoom": true,
  "soft_wrap": "none",
  "inlay_hints": { "enabled": true },
  "semantic_tokens": "combined",
  "document_folding_ranges": "on",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.bundle",
    "**/.idea",
    "**/.vscode",
    "**/.cursor"
  ],
  "project_panel": {
    "sort_order": "unicode",
    "folder_indicator": "both",
    "dock": "left",
    "git_status": true
  },
  "outline_panel": {
    "folder_indicator": "both",
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "sidebar_side": "right",
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev"
      ]
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.6-luna"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "auto_install_extensions": {
    "ruby": true,
    "vue": true,
    "html": true,
    "emmet": true,
    "toml": true,
    "env": true
  },
  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "featuresConfiguration": {
          "inlayHint": {
            "implicitRescue": true,
            "implicitHashValue": false
          }
        },
        "enabledFeatures": {
          "diagnostics": false
        }
      }
    },
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "erb": "html",
          "ruby": "html"
        },
        "experimental": {
          "classRegex": [
            "\\bclass:\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    }
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      { "token_type": "variable", "token_modifiers": ["defaultLibrary"], "style": ["variable.special"] },
      { "token_type": "variable", "foreground_color": "#d4b021", "font_style": "italic" },
      { "token_type": "parameter", "foreground_color": "#d4b021", "font_style": "italic" },
      { "token_type": "method" }
    ]
  },
  "languages": {
    "Ruby": {
      "document_symbols": "on",
      "language_servers": [
        "ruby-lsp",
        "rubocop"
      ],
      "formatter": {
        "language_server": {
          "name": "rubocop"
        }
      }
    },
    "HTML+ERB": {
      "language_servers": [
        "ruby-lsp",
        "herb",
        "tailwindcss-language-server"
      ]
    }
  },
  "agent_servers": {
    "Claude Agent": {
      "type": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp@0.78.0"
      ],
      "env": {}
    }
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "buffer_line_height": {
    "custom": 1.2
  },
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "vertical_scroll_margin": 0,
  "terminal": {
    "option_as_meta": true
  },
  "max_tabs": 10,
  "preview_tabs": {
    "enabled": false
  }
}
